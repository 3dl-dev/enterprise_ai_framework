{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "enterprise-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Enterprise AI",
      "options": {
        "baseURL": "{env:OPENAI_API_BASE}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "example-large": {
          "name": "GLM 5.2",
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "example-small": {
          "name": "GLM 4.7",
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "qwen3-coder-480b-a35b-instruct@deepinfra": {
          "name": "Qwen3 Coder 480B",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "deepseek-v4-pro@deepinfra": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "deepseek-v4-flash@deepinfra": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "enterprise-ai/example-large",
  "theme": "system",
  "instructions": [
    "/etc/opencode/PLATFORM.md",
    "/etc/opencode/tenant/TENANT.md",
    "/etc/opencode/memory/MEMORY.md"
  ],
  "skills": {
    "paths": ["/etc/opencode/tenant-skills"]
  },
  "mcp": {
    "echo": {
      "type": "remote",
      "url": "http://mcp-echo:8080/mcp",
      "enabled": true
    }
  }
}
