#!/bin/bash
# publish — copy this project somewhere a parent can open it.
#
#   publish            publish the whole project
#   publish dist       publish just ./dist
#
# WHY IT IS AN EXPLICIT COMMAND
#
# Everything else in this workspace sits behind a login. A parent has no account, so the
# only way they see anything is if it is copied OUT of the authenticated area into a
# volume served with no authentication at all. That is a one-way door, so it is never
# automatic: nothing leaves unless a person types this word.
#
# What lands there is static files served by a plain web server with no interpreter, and
# no workspace volume is mounted alongside it — so a published page cannot reach back
# into anybody's work.
set -euo pipefail

USER_NAME="${WS_USER:-coder}"
PROJECTS_ROOT="${WS_PROJECTS_ROOT:-/workspace/projects}"
ACTIVE="$(cat "${PROJECTS_ROOT}/.active" 2>/dev/null || echo my-first-project)"

# ACTIVE decides BOTH what gets published and where it lands. It used to decide only the
# destination, while the source came from WS_PROJECT_DIR — a value fixed at the moment the
# terminal connected. ttyd spawns one shell per websocket and switching project in the UI
# does not disturb an already-open one, so the two disagreed as soon as anyone switched
# without reloading the terminal: the OLD project's files were copied to the NEW project's
# public link. The parent opens a link to the wrong game and the child cannot see why.
PROJECT="${PROJECTS_ROOT}/${ACTIVE}"
SRC="$(cd "${1:-$PROJECT}" 2>/dev/null && pwd)" || { echo "publish: no such directory: ${1:-$PROJECT}" >&2; exit 1; }

# An explicit argument may narrow what is published (`publish dist`) but must never widen
# it to somebody else's project — the destination below is fixed to ACTIVE, so anything
# outside it would be published under the wrong name.
PROJECT_REAL="$(cd "$PROJECT" 2>/dev/null && pwd)" || PROJECT_REAL="$PROJECT"
if [[ "$SRC" != "$PROJECT_REAL" && "$SRC" != "$PROJECT_REAL"/* ]]; then
    echo "publish: ${SRC} is not inside the active project (${ACTIVE})." >&2
    echo "         Publishing it would put it under '${ACTIVE}' and mislabel whose work it is." >&2
    echo "         Switch project first, or pass a path inside ${PROJECT_REAL}." >&2
    exit 1
fi

# /published in the pod, where the no-login web server reads from. Overridable ONLY so
# this script can be exercised outside a pod; nothing in the deployment sets it.
PUBLISHED_ROOT="${WS_PUBLISHED_ROOT:-/published}"

# Each project gets its own published path. The first version published every project to
# the same place, so a second game replaced the link a parent had already been sent.
DEST="${PUBLISHED_ROOT}/${USER_NAME}/${ACTIVE}"

if [[ ! -d "$PUBLISHED_ROOT" ]]; then
    echo "publish: this workspace has no published volume mounted." >&2
    echo "         Ask the operator to re-provision it." >&2
    exit 1
fi

if [[ ! -f "$SRC/index.html" ]]; then
    echo "publish: $SRC has no index.html, so a browser would have nothing to open."
    echo
    echo "  Ask the agent: \"put the game in an index.html I can open in a browser\""
    exit 1
fi

# node_modules and .git are excluded (they never belong in a published folder); the cap
# is on what actually ships. 20MB fit a single hand-written index.html with inlined art,
# but a real engine export does not: a Godot or Unity WebAssembly build is a ~30-60MB
# .wasm plus a packed-data blob, all of it legitimately part of the game. The cap exists
# so a whole source tree does not get shipped by accident, not to rule out engines — so it
# sits above a normal engine export and below "you published the wrong directory".
SIZE_KB=$(du -sk --exclude=.git --exclude=node_modules "$SRC" | cut -f1)
if (( SIZE_KB > 262144 )); then
    echo "publish: that folder is ${SIZE_KB}KB (over 256MB), larger than a share is meant for." >&2
    echo "         If this is an engine project, publish the exported build folder" >&2
    echo "         (e.g. 'publish dist') rather than the whole project with its source." >&2
    exit 1
fi

echo "==> publishing $SRC"
mkdir -p "$DEST"
# --delete so republishing REPLACES rather than layering a new version over an old one;
# a stale file left behind is how a parent ends up looking at last week's version.
rsync -a --delete \
    --exclude=.git --exclude=node_modules --exclude=__pycache__ --exclude='*.pyc' \
    "$SRC"/ "$DEST"/

echo
echo "  Published. Anyone with this link can open it — no login needed:"
echo
echo "      ${WS_PUBLISH_URL:-http://<ask the operator>}/live/${USER_NAME}/${ACTIVE}/"
echo
echo "  Run 'publish' again to replace it with your latest version."
