# direnv environment for this repo.
#
# Forge credentials are resolved from 1Password once, when direnv loads this file, and
# then live in the shell environment. Nothing here is a secret — these are references, so
# this file is committed.
#
# The item title contains a "/", which op:// cannot parse, so it is addressed by its
# stable item ID instead. The ID does not change when the item is renamed.
#
# Requires: direnv (hooked in your shell) and `op signin`. Run `direnv allow` once.

OP_VAULT="3dl-ops"
OP_ITEM="5oxt4cqtp76jyk32yhdm7jez7a"   # "Forge / enterprise-ai-framework"

if ! command -v op >/dev/null 2>&1; then
    echo "direnv: 1Password CLI not found — Forge credentials not loaded" >&2
elif ! op account list >/dev/null 2>&1; then
    # Do not hard-fail: a shell that cannot be entered because a vault is locked is worse
    # than one missing an optional credential. The bundle still runs on the fake provider.
    echo "direnv: not signed in to 1Password — run 'op signin', then 'direnv reload'" >&2
else
    export FORGE_BASE_URL="$(op read "op://${OP_VAULT}/${OP_ITEM}/FORGE_BASE_URL")"
    export FORGE_ACCOUNT_ID="$(op read "op://${OP_VAULT}/${OP_ITEM}/FORGE_ACCOUNT_ID")"

    # Agent key: runtime inference. Can spend, cannot mint keys. This is the one the
    # gateway container receives.
    export FORGE_API_KEY="$(op read "op://${OP_VAULT}/${OP_ITEM}/FORGE_API_KEY")"

    # Admin key: setup-time only — reads the rate card and usage. Never declared in
    # docker-compose.yml, so it is not passed to any container, and never written to
    # bundle/.env. It exists in this shell so config rendering and the live tests stop
    # shelling out to `op` on every call.
    export FORGE_ADMIN_KEY="$(op read "op://${OP_VAULT}/${OP_ITEM}/FORGE_ADMIN_KEY")"
fi

# Local overrides, gitignored. Use for pointing at a different Forge, or unsetting the
# admin key when you want to prove something works without it.
[ -f .envrc.local ] && source_env .envrc.local
