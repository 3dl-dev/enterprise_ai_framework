.ready/
node_modules/
__pycache__/
.env
*.log

# Rendered from keycloak/realm-export.template.json at bundle-up; contains client secrets.
bundle/keycloak/realm-export.json

# Rendered from searxng/settings.template.yml at bundle-up; contains the instance secret.
bundle/searxng/settings.yml

# test venv
.venv-test/

# Self-signed TLS material generated at bundle-up.
bundle/certs/

# Ledger exports produced by the exit path.
bundle/exports/

# Generated gateway catalog and Forge caches.
bundle/litellm/config.generated.yaml
bundle/litellm/forge-pricing.cache.json
bundle/litellm/forge-catalog.cache.json

# direnv local overrides (may contain secrets).
.envrc.local

# Workflow agent worktrees — transient, and each is its own git repo.
.claude/worktrees/

# Runtime audit-trail output must never be committed to the distributable (hoistable-split)
bundle/audit.jsonl
