# Copy to .env, or let `make up` generate one with random secrets.
# .env is gitignored. Never commit real secrets.

# --- Postgres (welded; one server, one database per component) ---
POSTGRES_USER=eai
POSTGRES_PASSWORD=

# --- Identity (Keycloak) ---
IDP_ADMIN_USER=admin
IDP_ADMIN_PASSWORD=
IDP_REALM=enterprise-ai
IDP_CLIENT_SECRET=
IDP_PORT=8082
IDP_HTTPS_PORT=8443

# --- Gateway (LiteLLM, MIT core) ---
GATEWAY_MASTER_KEY=
GATEWAY_SALT_KEY=
GATEWAY_PORT=4000

# --- Control plane ---
CONTROL_PLANE_ADMIN_TOKEN=
CONTROL_PLANE_PORT=8081

# --- Bootstrap user ---
# Created in the realm on `make up` so the bundle is usable immediately.
BOOTSTRAP_USER=baron
BOOTSTRAP_EMAIL=baron@3dl.dev
BOOTSTRAP_PASSWORD=

# --- Chat surface ---
CHAT_PORT=3080
CHAT_CLIENT_SECRET=
CHAT_SESSION_SECRET=
CHAT_JWT_SECRET=
CHAT_JWT_REFRESH_SECRET=
CHAT_CREDS_KEY=
CHAT_CREDS_IV=
# Minted by bin/provision-chat-key.sh against the gateway. Not a provider key.
CHAT_VIRTUAL_KEY=

# --- Real upstream providers ---
# Leave empty to run entirely against the fake provider with no account and no spend.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
