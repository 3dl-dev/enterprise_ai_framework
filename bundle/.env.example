# Copy to .env, or let `make up` generate one with random secrets.
# .env is gitignored. Never commit real secrets.

# --- Compose isolation (enterpriseaiframework-0e3) ---
# Set automatically by bin/render-env.sh: the primary checkout keeps "enterprise-ai" and
# the fixed ports below; a linked git worktree gets a distinct project name and a
# deterministic port offset, so a worktree's `make up`/`make down`/`make nuke` cannot
# touch the primary checkout's containers. Leave blank here — do not hand-set.
COMPOSE_PROJECT_NAME=

# --- Postgres (welded; one server, one database per component) ---
POSTGRES_USER=eai
POSTGRES_PASSWORD=

# --- Identity (Keycloak) ---
IDP_ADMIN_USER=admin
IDP_ADMIN_PASSWORD=
IDP_REALM=enterprise-ai
IDP_CLIENT_SECRET=
IDP_PORT=8082
IDP_HTTPS_PORT=8443

# --- Fake provider (dogfood default upstream) ---
FAKEPROVIDER_PORT=8090

# --- Gateway (LiteLLM, MIT core) ---
GATEWAY_MASTER_KEY=
GATEWAY_SALT_KEY=
GATEWAY_PORT=4000

# --- Control plane ---
CONTROL_PLANE_ADMIN_TOKEN=
CONTROL_PLANE_PORT=8081

# --- Bootstrap user ---
# Created in the realm on `make up` so the bundle is usable immediately.
BOOTSTRAP_USER=baron
BOOTSTRAP_EMAIL=baron@3dl.dev
BOOTSTRAP_PASSWORD=

# --- Chat surface ---
CHAT_PORT=3080
CHAT_CLIENT_SECRET=
CHAT_SESSION_SECRET=
CHAT_JWT_SECRET=
CHAT_JWT_REFRESH_SECRET=
CHAT_CREDS_KEY=
CHAT_CREDS_IV=
# Minted by bin/provision-chat-key.sh against the gateway. Not a provider key.
CHAT_VIRTUAL_KEY=

# --- Web search (enterpriseaiframework-0be) ---
# WEBFETCH_TOKEN is the credential the chat surface presents to the fetch service as its
# `firecrawlApiKey`. It must be non-empty for a reason beyond authentication: LibreChat's
# Firecrawl client skips the HTTP request entirely when its key is empty, which turns web
# search into an answer citing pages nothing fetched. Generated by bin/render-env.sh.
WEBFETCH_TOKEN=
# Hosts exempt from the fetch service's private-address guard, comma-separated. EMPTY IS
# THE CORRECT DEFAULT: search results are attacker-influenceable at one remove, so an
# unguarded fetcher is a read primitive against the gateway, the control plane and the
# cloud metadata endpoint. Name individual intranet hosts here only if you mean it.
WEBFETCH_ALLOW_HOSTS=
# RERANK_TOKEN is the credential the chat surface presents to the rerank service as its
# `jinaApiKey`. It must be non-empty for the same reason WEBFETCH_TOKEN is: an empty
# value would silently reproduce JinaReranker's own first-N-chunks-score-0 fallback
# instead of running our BM25 ranking. Generated by bin/render-env.sh.
RERANK_TOKEN=
# SearXNG's instance secret. It refuses to start on its upstream placeholder.
SEARXNG_SECRET=

# --- Conversation search (enterpriseaiframework-2a6) ---
# LibreChat's own native search (SEARCH=true + MEILI_HOST + MEILI_MASTER_KEY), backed
# by a self-hosted Meilisearch (MIT core license) — configuration, not construction.
# Generated by bin/render-env.sh.
MEILI_MASTER_KEY=

# --- Real upstream providers ---
# Leave empty to run entirely against the fake provider with no account and no spend.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- codeapi: self-hosted code-execution sandbox (enterpriseaiframework-082) ---
# ClickHouse/code-interpreter, Apache 2.0, vendored at bundle/codeapi. Its own Valkey
# and S3 store — not the bundle's shared ones, which lack the password every codeapi
# component requires. NsJail isolation mode only (no libkrun microVM/guest kernel —
# ADDITIVE hardening deferred, not built here). Generated by `make up`; leave blank.
CODEAPI_REDIS_PASSWORD=
CODEAPI_INTERNAL_SERVICE_TOKEN=
CODEAPI_EGRESS_GRANT_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Ed25519 PEM pair (bin/render-codeapi-keys.py). LibreChat signs a <=300s JWT per
# request with the private half naming the AUTHENTICATED user; codeapi's api service
# verifies it with the public half. This is the ONLY credential that gets to assert who
# the caller is — Finding 27.
CODEAPI_JWT_PRIVATE_KEY=
CODEAPI_JWT_PUBLIC_KEY=
# Ed25519 base64 DER pair (execution-manifest.ts base64-decodes before
# createPrivateKey/createPublicKey — DER, NOT the PEM pair above; the two encodings
# are not interchangeable). codeapi's worker signs a per-job manifest with the private
# half; codeapi-sandbox verifies it, never receiving the private half.
CODEAPI_EXECUTION_MANIFEST_PRIVATE_KEY=
SANDBOX_EXECUTION_MANIFEST_PUBLIC_KEY=
